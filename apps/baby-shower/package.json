{
  "name": "baby-shower",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/main.ts",
    "build": "bun run build:css && bun run build:islands",
    "build:css": "bunx @tailwindcss/cli -i src/global.css -o static/global.css --minify",
    "build:islands": "bun build src/islands.ts --outdir static --target browser --minify",
    "start": "bun run src/main.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "hono": "^4.13.1",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.1",
    "preact-render-to-string": "^6.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "bun-types": "^1.3.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
